# Copy to .env (project root) and adjust. All values are optional.

# Server
CAPTION_HOST=127.0.0.1
CAPTION_PORT=8000

# Speech recognition
#   tiny | base | small | medium | large-v3-turbo | large-v3   (or any CTranslate2 Whisper repo id on Hugging Face)
#   For Urdu, large-v3-turbo / medium are noticeably more accurate than small, but slower on CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto (int8 on CPU, float16 on GPU) | int8 | int8_float16 | float16
WHISPER_CPU_THREADS=0          # 0 = automatic
DETECT_LANGUAGE_ON_UPLOAD=1    # detect spoken language right after upload

# Background jobs running at once (transcription is always one at a time to protect RAM)
CAPTION_MAX_WORKERS=2

# Storage locations (defaults shown)
# CAPTION_DATA_DIR=./data                 SQLite database + downloaded models
# CAPTION_UPLOAD_DIR=./backend/uploads    original videos + derived audio/waveform/proxy
# CAPTION_EXPORT_DIR=./backend/exports    rendered MP4 and subtitle files
# CAPTION_TEMP_DIR=./backend/temp         render scratch space (cleaned automatically)

# FFmpeg (if it isn't on PATH)
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe
